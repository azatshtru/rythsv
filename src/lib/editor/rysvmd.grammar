@top Document { line* }

line {
    Title |
    Heading |
    Subheading |
    Paragraph
}

Title { h1Marker Text newline }
Heading { h2Marker Text newline }
Subheading { h3Marker Text newline }
Paragraph { Text newline }

@tokens {
    h1Marker { "# " }
    h2Marker { "## " }
    h3Marker { "### " }
    newline { "\n" }
    Text { ![\n]+ }

    @precedence { h3Marker, h2Marker, h1Marker, Text }
}
